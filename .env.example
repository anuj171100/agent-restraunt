# Places Text Search and the Place Details review summary.
GOOGLE_PLACES_API_KEY=

# Web search, used to find menu pages.
TAVILY_API_KEY=

# OpenRouter key and model. The agent decides every tool call.
# Model ids need the provider prefix, for example openai/gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4o-mini

CACHE_DIR=cache
RUNS_DIR=runs
